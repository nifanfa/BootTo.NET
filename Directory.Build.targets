<Project>

  <Import Project="Qemu.targets" Condition="'$(MSBuildProjectExtension)' == '.csproj'" />

  <PropertyGroup Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(MSBuildProjectExtension)' == '.csproj'">
    <StartAction>Program</StartAction>
    <StartProgram>cmd.exe</StartProgram>
    <StartArguments>/d /s /c &quot;&quot;$(QemuExecutable)&quot; $(QemuArguments)&quot;</StartArguments>
    <StartWorkingDirectory>$(MSBuildThisFileDirectory)</StartWorkingDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <NoConfig>true</NoConfig>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ImplicitUsings>disable</ImplicitUsings>
    <IL2LLVMTool>$(MSBuildThisFileDirectory)IL2LLVM\IL2LLVM.exe</IL2LLVMTool>
    <IL2LLVMTarget>x86_64-pc-windows-msvc</IL2LLVMTarget>
    <IL2LLVMObject>$(ProjectDir)obj\$(Configuration)\$(TargetName).obj</IL2LLVMObject>
    <EfiApplicationProject>$(MSBuildThisFileDirectory)EfiApplication\EfiApplication.vcxproj</EfiApplicationProject>
    <DisableFastUpToDateCheck Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</DisableFastUpToDateCheck>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--CustomizeReferences-->
  <Target Name="CustomizeReferences" BeforeTargets="BeforeCompile" AfterTargets="FindReferenceAssembliesForReferences" Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <ItemGroup>
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" />
      <ReferencePath Remove="@(ReferencePath)" />
    </ItemGroup>
  </Target>

  <Target Name="CompileWithIL2LLVM"
          AfterTargets="Build"
          Inputs="$(TargetPath);$(IL2LLVMTool)"
          Outputs="$(IL2LLVMObject)"
          Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Error Condition="!Exists('$(IL2LLVMTool)')" Text="IL2LLVM was not found at $(IL2LLVMTool)." />
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(IL2LLVMObject)'))" />
    <Exec Command="&quot;$(IL2LLVMTool)&quot; &quot;$(TargetPath)&quot; &quot;$(IL2LLVMObject)&quot; &quot;$(IL2LLVMTarget)&quot;" />
  </Target>

  <Target Name="BuildEfiApplication"
          AfterTargets="CompileWithIL2LLVM"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(MSBuildProjectExtension)' == '.csproj'">
    <MSBuild Projects="$(EfiApplicationProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=x64;SolutionDir=$(MSBuildThisFileDirectory)" />
  </Target>

  <Target Name="CreateQemuDiskImageAfterEfiApplication"
          AfterTargets="BuildEfiApplication"
          DependsOnTargets="CreateQemuDiskImage"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(MSBuildProjectExtension)' == '.csproj'" />

</Project>
